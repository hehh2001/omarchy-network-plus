#!/bin/bash

# User-owned helper for zzb.network:
# Enumerate NetworkManager-managed wired NICs and switch a NIC's IPv4
# profile between automatic DHCP and manual static addressing.
#
# Only real, attached hardware NICs are listed. Virtual/unbacked interfaces and
# the Apple T2 chip's always-present bridge Ethernet gadget are filtered out, so
# an empty list really means "no wired NIC attached" and the panel can hide the
# whole wired section instead of showing the last adapter it saw.

# omarchy:summary=Show/configure IPv4 settings for managed wired NICs
# omarchy:group=network
# omarchy:args=[list | set <device> <dhcp|manual> [ip] [prefix] [gateway] [dns]]

set -euo pipefail
export LC_ALL=C

# nmcli -e no keeps ':' and '\' verbatim in values; -g asks for one field at a
# time so values can never be confused with separators.
nm_get() {
  local field=$1
  shift
  nmcli -e no -g "$field" "$@" 2>/dev/null || true
}

# Kernel view of the network interfaces. Tests point this at a fixture tree so
# the hardware checks below can be exercised without touching the live host.
net_sysfs() {
  printf '%s\n' "${OMARCHY_NET_SYSFS:-/sys/class/net}"
}

device_state() {
  local dev=$1
  nmcli -e no -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: -v want="$dev" '
    $1 == want { print $3; exit }
  '
}

device_carrier() {
  local dev=$1 root
  root=$(net_sysfs)
  if [[ -r $root/$dev/carrier ]]; then
    cat "$root/$dev/carrier" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

# Whether the kernel still has the hardware behind this interface. A netdev
# whose `device` link dangles was unplugged while NetworkManager kept the device
# around; that ghost is what used to linger in the panel as "the last record".
# Interfaces with no `device` node at all (Thunderbolt IP links, for example)
# are left alone -- NetworkManager's device type already keeps bridges, bonds,
# vlans and tunnels out of this list.
has_hardware() {
  local dev=$1 root
  root=$(net_sysfs)
  [[ -d $root/$dev ]] || return 1
  if [[ -L $root/$dev/device && ! -e $root/$dev/device ]]; then
    return 1
  fi
  return 0
}

# Apple T2 Macs (apple-bce) publish a virtual CDC-NCM "Apple T2 Controller"
# Ethernet gadget on their own USB bus. It exists even when no wired NIC is
# attached, reports carrier=1, and never passes traffic -- NetworkManager just
# retries DHCP on it forever. It is not a NIC the user attached, so it must
# never create a row: without this the panel looks like it kept the last
# adapter, which is exactly the stale record this plugin is not supposed to
# show. A real Ethernet NIC (Thunderbolt/PCIe/USB-C dock) is a separate device
# and is unaffected.
is_t2_bridge_device() {
  local dev=$1 root path parent vid pid
  root=$(net_sysfs)
  path=$(readlink -f "$root/$dev/device" 2>/dev/null) || return 1
  [[ -n $path ]] || return 1
  if [[ $path == *t2bce* ]]; then
    return 0
  fi

  # USB hosts: the interface node is usbN/<port>/<port>:<config>, so the USB
  # device that owns it is its parent. PCI devices have no idVendor there.
  parent=$(dirname -- "$path")
  vid=$(cat "$parent/idVendor" 2>/dev/null || true)
  pid=$(cat "$parent/idProduct" 2>/dev/null || true)
  if [[ $vid == 05ac && $pid == 8233 ]]; then
    return 0
  fi

  return 1
}

# Return the UUID of the profile bound to the device. UUIDs are authoritative;
# connection names are user-editable and need not be unique.
profile_for_device() {
  local dev=$1
  local active
  local devmac uuid type iface mac name auto found=""

  active=$(nm_get GENERAL.CON-UUID device show "$dev")
  if [[ -n $active && $active != "--" ]]; then
    echo "$active"
    return 0
  fi

  devmac=$(cat "/sys/class/net/$dev/address" 2>/dev/null || true)

  while IFS=: read -r uuid type; do
    [[ -n $uuid && $type == 802-3-ethernet ]] || continue

    iface=$(nm_get connection.interface-name connection show uuid "$uuid")
    mac=$(nm_get 802-3-ethernet.mac-address connection show uuid "$uuid")
    [[ $iface == "$dev" ]] || { [[ -n $devmac && -n $mac && $mac == "$devmac" ]]; } || continue

    name=$(nm_get connection.id connection show uuid "$uuid")
    [[ -n $name ]] || continue
    auto=$(nm_get connection.autoconnect connection show uuid "$uuid")
    if [[ -z $found ]]; then
      found=$uuid
    fi
    if [[ $auto == yes ]]; then
      echo "$uuid"
      return 0
    fi
  done < <(nmcli -e no -g UUID,TYPE connection show)

  [[ -z $found ]] || echo "$found"
}

first_line() {
  head -n 1
}

clean_dns() {
  tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//'
}

list_devices() {
  local line dev type state carrier profile_uuid profile method addrs addr prefix gateway dns live_ip live_gw

  while IFS=: read -r dev type state; do
    [[ $type == ethernet ]] || continue
    [[ $state != unmanaged ]] || continue

    # Only hardware that is actually attached gets a row. Everything below
    # reads live state from that hardware, and the panel hides the whole wired
    # section when this emits nothing.
    if ! has_hardware "$dev"; then
      continue
    fi
    if is_t2_bridge_device "$dev"; then
      continue
    fi

    carrier=$(device_carrier "$dev")
    state=${state%% *}

    profile_uuid=$(profile_for_device "$dev")
    profile=""
    method=auto
    addr=""
    prefix=""
    gateway=""
    dns=""

    if [[ -n $profile_uuid ]]; then
      profile=$(nm_get connection.id connection show uuid "$profile_uuid")
      method=$(nm_get ipv4.method connection show uuid "$profile_uuid")
      [[ -n $method ]] || method=auto

      if [[ $method == manual ]]; then
        addrs=$(nm_get ipv4.addresses connection show uuid "$profile_uuid" | first_line)
        if [[ -n $addrs ]]; then
          if [[ $addrs == */* ]]; then
            addr=${addrs%/*}
            prefix=${addrs##*/}
          else
            addr=$addrs
          fi
        fi
        gateway=$(nm_get ipv4.gateway connection show uuid "$profile_uuid" | first_line)
        dns=$(nm_get ipv4.dns connection show uuid "$profile_uuid" | clean_dns)
      fi
    fi

    live_ip=$(nm_get IP4.ADDRESS device show "$dev" | first_line)
    live_gw=$(nm_get IP4.GATEWAY device show "$dev" | first_line)

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$dev" "$carrier" "$state" "$profile" "$method" \
      "$addr" "$prefix" "$gateway" "$dns" "$live_ip" "$live_gw"
  done < <(nmcli -e no -t -f DEVICE,TYPE,STATE device status)
}

# Make sure there is an editable NetworkManager profile for this interface.
# NM would normally auto-create one on `device connect`; when we are setting a
# static IP before any DHCP server answers we need the profile to exist first.
ensure_profile() {
  local dev=$1 profile con_name

  profile=$(profile_for_device "$dev")
  if [[ -n $profile ]]; then
    echo "$profile"
    return 0
  fi

  con_name="Wired $dev"
  nmcli connection add \
    type ethernet \
    con-name "$con_name" \
    ifname "$dev" \
    connection.autoconnect yes \
    >/dev/null
  profile_for_device "$dev"
}

# True once NM has the requested IPv4 state on the device.  For manual we also
# check the actual address, not just "connected": nmcli device reapply can
# return before an async activation failure (duplicate IP, bad gateway, etc.)
# is noticed, and without this check the panel would claim success while the
# NIC was actually still on the old address or already down.
device_has_ipv4_state() {
  local dev=$1 profile_uuid=$2 mode=$3 expected_ip=${4:-}
  local state active_uuid addr dhcp

  state=$(device_state "$dev")
  [[ $state == connected* ]] || return 1
  active_uuid=$(nm_get GENERAL.CON-UUID device show "$dev")
  [[ $active_uuid == "$profile_uuid" ]] || return 1

  if [[ $mode == manual && -n $expected_ip ]]; then
    addr=$(nm_get IP4.ADDRESS device show "$dev" | first_line)
    [[ $addr == "$expected_ip"/* ]] || return 1
  elif [[ $mode == dhcp ]]; then
    addr=$(nm_get IP4.ADDRESS device show "$dev" | first_line)
    dhcp=$(nm_get DHCP4.OPTION device show "$dev")
    [[ -n $addr && $dhcp == *"ip_address ="* ]] || return 1
  fi

  return 0
}

apply_connection() {
  local dev=$1 profile_uuid=$2 mode=$3 old_mode=$4 expected_ip=${5:-}
  local state carrier active_uuid i

  state=$(device_state "$dev")
  carrier=$(device_carrier "$dev")

  # No cable: nothing to activate, saving the profile is the correct outcome.
  # The profile will come up on its own when a cable is attached.
  [[ $carrier == 1 ]] || return 0

  if [[ $state == connected* && $old_mode == "$mode" && $mode == manual ]]; then
    # Least disruptive path: reapply the updated profile in place. NM can
    # return success before an async failure, so wait briefly and verify the
    # device really is connected with the requested address.  If not, fall
    # through to a full reactivation which reports real activation errors.
    # DHCP always takes the full reactivation path below: `reapply` can return
    # while the old static address is still in place, which would look like an
    # instant success without an actual DHCP lease.
    if nmcli device reapply "$dev" >/dev/null 2>&1; then
      for ((i = 0; i < 5; i++)); do
        if device_has_ipv4_state "$dev" "$profile_uuid" "$mode" "$expected_ip"; then
          return 0
        fi
        sleep 1
      done
    fi
  fi

  # A method transition needs a clean deactivate/activate cycle. In particular,
  # activating an already-active profile after manual -> auto can leave the old
  # static address in the applied connection. Only this NIC is cycled; the host
  # and NetworkManager stay up.
  active_uuid=$(nm_get GENERAL.CON-UUID device show "$dev")
  if [[ $active_uuid == "$profile_uuid" ]]; then
    nmcli --wait 10 connection down uuid "$profile_uuid" >/dev/null
  fi
  nmcli --wait 30 connection up uuid "$profile_uuid" ifname "$dev" >/dev/null

  for ((i = 0; i < 10; i++)); do
    if device_has_ipv4_state "$dev" "$profile_uuid" "$mode" "$expected_ip"; then
      return 0
    fi
    sleep 1
  done

  echo "Error: NetworkManager activated $dev but the requested $mode IPv4 configuration did not take effect." >&2
  return 1
}

set_command() {
  local dev mode
  local profile old_mode ip prefix gateway dns

  if (($# < 2)); then
    echo "Usage: omarchy-network-eth-config set <device> <dhcp|manual> [ip] [prefix] [gateway] [dns]" >&2
    exit 2
  fi

  dev=$1
  mode=$2

  profile=$(ensure_profile "$dev")
  if [[ -z $profile ]]; then
    echo "Error: could not find or create a NetworkManager profile for $dev." >&2
    exit 1
  fi
  old_mode=$(nm_get ipv4.method connection show uuid "$profile")

  case $mode in
    dhcp|auto)
      nmcli connection modify uuid "$profile" \
        connection.autoconnect yes \
        ipv4.method auto \
        ipv4.addresses "" \
        ipv4.gateway "" \
        ipv4.dns "" \
        ipv4.dns-search "" \
        ipv4.ignore-auto-dns no \
        >/dev/null
      ;;

    manual)
      if (($# < 4)); then
        echo "Usage: omarchy-network-eth-config set <device> manual <ip> [prefix] [gateway] [dns]" >&2
        exit 2
      fi

      ip=$3
      prefix=${4:-24}
      gateway=${5:-}
      dns=${6:-}

      if [[ -z $ip ]]; then
        echo "Error: an IP address is required for manual configuration." >&2
        exit 1
      fi

      if [[ -n $dns ]]; then
        nmcli connection modify uuid "$profile" \
          connection.autoconnect yes \
          ipv4.method manual \
          ipv4.addresses "$ip/$prefix" \
          ipv4.gateway "$gateway" \
          ipv4.dns "$dns" \
          ipv4.dns-search "" \
          ipv4.ignore-auto-dns yes \
          >/dev/null
      else
        nmcli connection modify uuid "$profile" \
          connection.autoconnect yes \
          ipv4.method manual \
          ipv4.addresses "$ip/$prefix" \
          ipv4.gateway "$gateway" \
          ipv4.dns "" \
          ipv4.dns-search "" \
          ipv4.ignore-auto-dns no \
          >/dev/null
      fi
      ;;

    *)
      echo "Error: unknown mode '$mode' (expected dhcp or manual)." >&2
      exit 2
      ;;
  esac

  [[ $mode != auto ]] || mode=dhcp
  apply_connection "$dev" "$profile" "$mode" "$old_mode" "${ip:-}"
}

usage() {
  echo "Usage: omarchy-network-eth-config list" >&2
  echo "       omarchy-network-eth-config set <device> dhcp" >&2
  echo "       omarchy-network-eth-config set <device> manual <ip> [prefix] [gateway] [dns]" >&2
}

if (($# == 0)); then
  usage
  exit 2
fi

case $1 in
  list)
    list_devices
    ;;
  set)
    shift
    set_command "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
